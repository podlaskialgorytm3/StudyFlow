# Database Connection URL (PostgreSQL)
# For local Docker: postgresql://studyflow:studyflow_password@localhost:5432/studyflow_db?schema=public
# For Supabase / Neon: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://studyflow:studyflow_password@localhost:5432/studyflow_db?schema=public"

# Session Secret (Minimum 32 characters for JOSE AES / HMAC signing)
SESSION_SECRET="studyflow_super_secret_jwt_key_must_be_at_least_32_characters_long_for_security"

# Initial Admin credentials for scripts/init-admin.ts
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMeInProduction123!"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Calendar OAuth 2.0 Credentials (obtain from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Secret key for encrypting OAuth tokens in database (AES-256-GCM, defaults to SESSION_SECRET if unset)
ENCRYPTION_KEY="studyflow_token_encryption_key_min_32_characters_long"

# Secret for background cron synchronization endpoint (/api/calendar/sync/cron)
CRON_SECRET="studyflow_cron_background_sync_secret_key"


