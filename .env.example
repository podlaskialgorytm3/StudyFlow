# Database Connection URL (PostgreSQL)
# For local Docker: postgresql://studyflow:studyflow_password@localhost:5432/studyflow_db?schema=public
# For Supabase / Neon: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://studyflow:studyflow_password@localhost:5432/studyflow_db?schema=public"

# Session Secret (Minimum 32 characters for JOSE AES / HMAC signing)
SESSION_SECRET="studyflow_super_secret_jwt_key_must_be_at_least_32_characters_long_for_security"

# Initial Admin credentials for scripts/init-admin.ts
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMeInProduction123!"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

