datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
}

enum TaskStatus {
  NEW
  TODO
  IN_PROGRESS
  DONE
}

enum PriorityOverride {
  IMPORTANT
  NOT_IMPORTANT
}

enum UrgencyOverride {
  URGENT
  NOT_URGENT
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  passwordHash String
  role         Role          @default(STUDENT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  settings              UserSettings?
  subjects              Subject[]
  categories            Category[]
  tasks                 Task[]
  googleCalendarAccount GoogleCalendarAccount?
  googleCalendarEvents  GoogleCalendarEvent[]

  @@map("users")
}

model UserSettings {
  id                            String   @id @default(uuid())
  userId                        String   @unique
  user                          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  importantStoryPointsThreshold Int      @default(6)
  urgentWithinDays              Int      @default(3)
  taskHorizonDays               Int      @default(7)
  calendarShowGoogleEvents      Boolean  @default(true)
  calendarShowStudyFlowTasks    Boolean  @default(true)
  encryptedGoogleClientId       String?
  encryptedGoogleClientSecret   String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@map("user_settings")
}

model GoogleCalendarAccount {
  id                   String    @id @default(uuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail          String?
  encryptedAccessToken String
  encryptedRefreshToken String?
  tokenExpiresAt       DateTime?
  scope                String?
  selectedCalendarId   String    @default("primary")
  selectedCalendarName String?
  syncFrequencyHours   Int       @default(3) // 1, 3, or 6
  nextSyncAt           DateTime?
  lastSyncAt           DateTime?
  lastSyncStatus       String?   // "SUCCESS", "ERROR", "IN_PROGRESS"
  lastSyncError        String?
  syncToken            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("google_calendar_accounts")
}

model GoogleCalendarEvent {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEventId String
  calendarId   String   @default("primary")
  summary      String
  description  String?
  location     String?
  startDateTime DateTime?
  endDateTime   DateTime?
  isAllDay     Boolean  @default(false)
  allDayDate   String?  // YYYY-MM-DD
  status       String   @default("confirmed") // "confirmed", "tentative", "cancelled"
  htmlLink     String?
  colorId      String?
  recurringEventId String?
  etag         String?
  updatedInGoogle DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, googleEventId])
  @@index([userId, startDateTime])
  @@index([userId, isAllDay, allDayDate])
  @@map("google_calendar_events")
}

model Subject {
  id          String     @id @default(uuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  categories  Category[]
  tasks       Task[]

  @@map("subjects")
}

model Category {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]

  @@map("categories")
}

model Task {
  id               String            @id @default(uuid())
  ownerId          String
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  dueDate          DateTime?
  storyPoints      Int               @default(1)
  status           TaskStatus        @default(NEW)
  priorityOverride PriorityOverride?
  urgencyOverride  UrgencyOverride?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  completedAt      DateTime?
  timeSpentSeconds Int               @default(0)
  estimatedMinutes Int               @default(60)
  progressPercent  Int               @default(0)

  timeEntries      TaskTimeEntry[]

  @@map("tasks")
}

model TaskTimeEntry {
  id              String   @id @default(uuid())
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  durationSeconds Int
  note            String?
  createdAt       DateTime @default(now())

  @@map("task_time_entries")
}

